---
// REEFLECT store list. Not selling online yet, so there is no cart.
import Base from '../../layouts/Base.astro';
---
<Base title="Store | Out to See Vision Care" canonical="/store">
  <section class="store blog-hero">
    <h1>Store</h1>
    <div class="grid">
      <a class="card" href="/store/p/reeflect-sunnies-polarized">
        <img src="/images/reeflectwebgrain.webp" alt="Reeflect Sunnies - Polarized" width="1500" height="1500" loading="lazy" />
        <h2>Reeflect Sunnies - Polarized</h2>
        <p>$149.00</p>
      </a>
    </div>
  </section>
</Base>
<style>
  .store { background: #fff; padding: 0 6vw 100px; }
  h1 { font: 500 44.8px/1.1 var(--heading-font); letter-spacing: -.02em; text-align: center; margin: 20px 0 50px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 340px)); justify-content: center; gap: 40px; }
  .card { color: hsla(var(--black-hsl), 1); text-decoration: none; }
  .card img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .card h2 { font: 500 20px/1.3 var(--heading-font); margin: 16px 0 4px; }
  .card p { margin: 0; }
</style>
